# Change this to a long random password BEFORE exposing the browser.
WEB_USER=admin
WEB_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

# Browser desktop resolution; accepted syntax: WIDTHxHEIGHTxDEPTH
SCREEN_RESOLUTION=1365x768x24
LOCAL_PORT=8080

# Default 0 (no rotation, just automatic restart after a crash / reboot).
# Optionally set 5.5 to deliberately restart the browser container every 5h30.
# The URL remains stable ONLY with a named Cloudflare Tunnel.
SESSION_ROTATE_HOURS=0

# Only needed for a named, stable Cloudflare Tunnel.
CLOUDFLARE_TUNNEL_TOKEN=
